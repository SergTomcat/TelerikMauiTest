<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
		   xmlns:mc="clr-namespace:WebsoftWorkspaceM.Messenger.Controls"
             x:Class="WebsoftWorkspaceM.Styles.Control_ChatIcon">

	<Style TargetType="mc:ChatIcon">
		<!--<Setter Property="Margin" Value="10"/>-->
		<Setter Property="WidthRequest" Value="44"/>
		<Setter Property="HeightRequest" Value="44"/>
		<Setter Property="BackgroundColor" Value="Transparent"/>
	</Style>

	<Style Class="ChatIcon" TargetType="Border">
		<Setter Property="WidthRequest" Value="40"/>
		<Setter Property="HeightRequest" Value="40"/>
		<Setter Property="StrokeShape" Value="RoundRectangle 20"/>
		<Setter Property="StrokeThickness" Value="0"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Margin" Value="0"/>
	</Style>
	<Style Class="ChatIconLabel" TargetType="Label">
		<Setter Property="FontSize" Value="18"/>
	</Style>
</ResourceDictionary>